# Copy this file to .env and fill in your values.
# Never commit .env to git — it's listed in the root .gitignore.

# Port the Express server listens on
PORT=5000

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/rate-your-resume?retryWrites=true&w=majority

# Secret key for signing JWT tokens (use a long random string in production)
JWT_SECRET=your_jwt_secret_here

# OpenAI API key for resume analysis
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API key for resume analysis
GEMINI_API_KEY=your_gemini_api_key_here
